OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Chat: the audience must match the value configured in the Chat API app.
# HTTP endpoint URL mode (recommended): https://<your-cloud-run-url>/google-chat
# Project number mode: the numeric Google Cloud project number
GOOGLE_CHAT_AUDIENCE=https://your-service-url.run.app/google-chat
